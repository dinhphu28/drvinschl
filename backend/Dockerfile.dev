# Stage 1: Cache Gradle dependencies
FROM eclipse-temurin:21-jdk AS cache
WORKDIR /app
COPY gradle/ gradle/
COPY gradlew build.gradle settings.gradle ./
RUN ./gradlew dependencies --no-daemon

# Stage 2: Development runtime
FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY --from=cache /root/.gradle /root/.gradle
COPY . .

EXPOSE 8080 5005

CMD ["./gradlew", "bootRun", "--no-daemon", "--rerun-tasks", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]

